foreach(mode IN ITEMS paced unlimited)
    set(extra_args)
    if(mode STREQUAL "unlimited")
        list(APPEND extra_args --no-limit)
    endif()
    file(REMOVE "${BENCH_CSV}")
    execute_process(
        COMMAND "${BENCH_EXE}" --seconds 0.1 --warmup 0 --csv "${BENCH_CSV}" ${extra_args}
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error
        TIMEOUT 20)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${mode} benchmark failed (${result}): ${output}\n${error}")
    endif()
    if(NOT EXISTS "${BENCH_CSV}")
        message(FATAL_ERROR "${mode} benchmark did not create CSV")
    endif()
    file(STRINGS "${BENCH_CSV}" csv_lines LIMIT_COUNT 2)
    list(LENGTH csv_lines line_count)
    if(line_count LESS 2)
        message(FATAL_ERROR "${mode} benchmark CSV has no frame data")
    endif()
    list(GET csv_lines 0 header)
    if(NOT output MATCHES "frame interval ms: p50 .*p99")
        message(FATAL_ERROR "${mode} benchmark is missing frame interval percentiles: ${output}")
    endif()
    if(TEST_WINDOWS)
        if(NOT output MATCHES "main-thread CPU: unavailable;.*F1 CPU p99 unavailable")
            message(FATAL_ERROR "${mode} benchmark did not label F1 unavailable: ${output}")
        endif()
        if(output MATCHES "main-thread CPU ms:")
            message(FATAL_ERROR "${mode} benchmark printed a Windows CPU percentile: ${output}")
        endif()
        if(NOT header STREQUAL "frame,frame_ms,update_ms,fixed_steps")
            message(FATAL_ERROR "${mode} benchmark CSV contains unexpected columns: ${header}")
        endif()
    else()
        if(NOT output MATCHES "main-thread CPU ms: p50 .*p99" OR
           NOT output MATCHES "CPU clock: CLOCK_THREAD_CPUTIME_ID")
            message(FATAL_ERROR "${mode} benchmark is missing Linux CPU reporting: ${output}")
        endif()
        if(NOT header STREQUAL "frame,frame_ms,update_ms,fixed_steps,cpu_ms")
            message(FATAL_ERROR "${mode} benchmark CSV is missing CPU data: ${header}")
        endif()
    endif()
endforeach()
file(REMOVE "${BENCH_CSV}")
