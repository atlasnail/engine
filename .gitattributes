# Normalize line endings in the repository, so Windows and Linux checkouts
# produce identical files (important for clang-format and reproducible builds).
* text=auto eol=lf

# Scripts that Windows shells require to be CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (declared now so future additions are handled correctly).
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tga binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.zip binary
*.exe binary
*.dll binary
*.lib binary
